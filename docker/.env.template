# ============================================================================
# PostgreSQL Configuration
# ============================================================================
POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=your_secure_database_password_here

# Authentik PostgreSQL config (mirrors POSTGRES_* vars)
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=your_secure_database_password_here

# ============================================================================
# Authentik Core Configuration
# ============================================================================
AUTHENTIK_SECRET_KEY=your_authentik_secret_key_here
AUTHENTIK_BOOTSTRAP_PASSWORD=your_initial_admin_password_here
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2025.10.3

# ============================================================================
# Email Configuration (Authentik-specific)
# ============================================================================
AUTHENTIK_EMAIL__FROM=noreply@authentik.example.com
AUTHENTIK_EMAIL__HOST=smtp.gmail.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=your_email@gmail.com
AUTHENTIK_EMAIL__PASSWORD=your_app_password_here
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10

# ============================================================================
# Email Configuration (Generic / Django-compatible)
# ============================================================================
DEFAULT_FROM_EMAIL=noreply@authentik.example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10

# ============================================================================
# Deployment Configuration
# ============================================================================
DATA_PATH=/data/lab-authentik-development
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Get tunnel token from: https://one.dash.cloudflare.com/
# Tunnel should be configured to target: http://server:9000

# ============================================================================
# Optional: Compose port mappings
# ============================================================================
# COMPOSE_PORT_HTTP=9000
# COMPOSE_PORT_HTTPS=9443